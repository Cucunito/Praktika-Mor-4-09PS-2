<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/projectCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Индикатор приоритета -->
        <View
            android:id="@+id/priorityIndicator"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#2196F3"/>

        <!-- Контент проекта -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Верхняя строка с иконкой и названием -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivProjectIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="#2196F3"
                    android:background="#E3F2FD"
                    android:padding="12dp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProjectName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TaskFlow"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1A1E2B"/>

                    <TextView
                        android:id="@+id/tvProjectDeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 16 фев 2026"
                        android:textSize="12sp"
                        android:textColor="#9AA6B8"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Описание -->
            <TextView
                android:id="@+id/tvProjectDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Разработка системы управления задачами"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp"/>

            <!-- Прогресс -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvProjectProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2196F3"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvProjectTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/23 задач"
                    android:textSize="14sp"
                    android:textColor="#9AA6B8"/>
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:progress="65"
                android:progressTint="#2196F3"
                android:progressBackgroundTint="#E0E0E0"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>