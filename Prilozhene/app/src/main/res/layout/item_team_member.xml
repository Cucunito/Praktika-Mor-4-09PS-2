<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/memberCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Верхняя строка с аватаркой и именем -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivMemberAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="#2196F3"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_report_image"/>

                <View
                    android:id="@+id/onlineIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/online_indicator"
                    android:layout_gravity="bottom|end"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMemberName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Иван Петров"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1E2B"/>

                <TextView
                    android:id="@+id/tvMemberPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ведущий разработчик"
                    android:textSize="14sp"
                    android:textColor="#2196F3"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Отдел -->
        <TextView
            android:id="@+id/tvMemberDepartment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отдел: Разработка"
            android:textSize="13sp"
            android:textColor="#666666"
            android:background="#F0F0F0"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Контакты -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvMemberEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✉️ ivan.petrov@company.com"
                android:textSize="12sp"
                android:textColor="#666666"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvMemberPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 +7 (999) 123-45-67"
                android:textSize="12sp"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- Статистика -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvMemberExperience"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⭐ С 2020"
                android:textSize="12sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/tvMemberProjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 15 проектов"
                android:textSize="12sp"
                android:textColor="#666666"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>